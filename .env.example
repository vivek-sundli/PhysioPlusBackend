# MongoDB Connection String
# Copy this file to .env and fill in your credentials
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.qo4kmpj.mongodb.net/PhysioPlus?appName=Cluster0

# ==================== Email (Gmail SMTP) ====================
# Use Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==================== SMS (MSG91) ====================
# Get credentials from: https://msg91.com/
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=PHYSIO

# ==================== Razorpay Payment ====================
# Get credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ==================== 100ms Video ====================
# Get credentials from: https://dashboard.100ms.live/
HMS_ACCESS_KEY=your-100ms-access-key
HMS_SECRET=your-100ms-secret
HMS_TEMPLATE_ID=default

# ==================== WhatsApp (Meta Cloud API) ====================
# Get credentials from: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=physioplus-webhook

# ==================== JWT Configuration ====================
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
